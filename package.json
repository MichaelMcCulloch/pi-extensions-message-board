{
  "name": "pi-message-board",
  "version": "0.1.0",
  "private": true,
  "description": "A pi extension giving agents two cooperation primitives \u2014 durable addressed mailboxes and an append-only forum \u2014 built on a formally verified multi-state-machine model.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./formal": "./src/formal/model.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:model": "node scripts/tla.mjs model",
    "verify:traces": "node scripts/tla.mjs traces",
    "verify:formal": "node scripts/tla.mjs all",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run verify:formal",
    "verify:proof": "node scripts/tlapm.mjs"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "agents",
    "message-board",
    "mailbox",
    "multi-agent",
    "tla+",
    "formal-verification"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
